# --- Model ---
# TimesFM checkpoint version. 2.5 = Apache-2.0 (default, commercial-safe).
# 3.0 = NON-COMMERCIAL weights; requires NON_COMMERCIAL=true below.
MODEL_VERSION=2.5
NON_COMMERCIAL=false

# Inference context length (trading days) fed to the model. 512 fits the 200m model.
CONTEXT_LENGTH=512
# auto | cpu | cuda | mps
DEVICE=auto
# Set to 1 to enable torch.compile (off by default; Windows-safe).
TIMESFM_TORCH_COMPILE=0

# --- Data ---
DATA_DIR=data
# Optional metals API for extra sources; leave empty to use yfinance only.
METALS_API_KEY=
# Full history start date for ingestion.
HISTORY_START=2016-01-01

# --- API (Stage B) ---
# Key required for POST /api/v1/refresh (X-API-Key header). Generate your own in prod.
API_KEY=change-me-please
# Browser origins allowed by CORS (comma-separated). Same-origin nginx-proxied
# requests are unaffected; this only matters for direct cross-origin API calls.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Scheduler ---
# Whether the scheduler runs inside the API process (1) or not (0).
ENABLE_SCHEDULER=1

# --- Cache locations (read by huggingface_hub / pip directly, not config.py) ---
# Set these as persistent User environment variables, not just per-shell:
#   [Environment]::SetEnvironmentVariable("HF_HOME", "D:\hf_cache", "User")
# ~1 GB of model weights; point at a drive with real headroom.
HF_HOME=D:\hf_cache
# Legacy transformeres cache (some tooling still reads it).
TRANSFORMERS_CACHE=D:\hf_cache\transformers
# Wheel cache for pip (keeps reinstall from requirements.txt fast).
PIP_CACHE_DIR=D:\pip_cache

# --- Docker (docker/docker-compose.yml) ---
# Host port for the nginx frontend container.
FRONTEND_PORT=5174

# --- Telegram alerts (optional) ---
# 1) Chat with @BotFather on Telegram -> /newbot -> copy the token here.
# 2) Message your bot once (press START), then get your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates  (field: message.chat.id)
#    or from @userinfobot. Add several ids comma-separated for family groups.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Public dashboard link appended to alerts (e.g. the Cloudflare tunnel URL).
DASHBOARD_URL=
