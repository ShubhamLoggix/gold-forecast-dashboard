# Backend: TimesFM forecast API (Stage B)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
# CPU-only torch first: the plain PyPI torch on Linux pulls the full CUDA stack
# (~3.5 GB of nvidia-* wheels) which CPU inference does not need. The pinned
# torch==2.10.0 in requirements.txt is then already satisfied and skipped.
RUN pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py logging_setup.py conversion.py ./
COPY ingestion ./ingestion
COPY forecasting ./forecasting
COPY api ./api
COPY scripts ./scripts

# Model weights are downloaded on first start into the mounted cache volume.
ENV HF_HOME=/data/hf_cache
ENV TIMESFM_TORCH_COMPILE=0
VOLUME ["/data"]

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health', timeout=5)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
