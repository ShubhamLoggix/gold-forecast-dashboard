server {
    listen 80;
    server_name _;

    # Docker's embedded DNS (required for variable proxy_pass resolution
    # at request time; without it nginx logs "no resolver defined" -> 502).
    resolver 127.0.0.11 valid=30s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Variable proxy_pass defers DNS resolution to request time, so nginx
        # starts even when the backend is unreachable; /api calls then return
        # 502 until the backend is up.
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
